{
  "manifest_version": 3,
  "name": "Pastilles Soundboard",
  "version": "2.0",
  "description": "Joue un son selon la couleur de tes pastilles EFE.",
  "action": { "default_popup": "popup.html", "default_title": "Pastilles Soundboard" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://efe.tspro.fr/*", "https://www.myinstants.com/*"]
}
